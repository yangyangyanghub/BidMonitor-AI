# BidMonitor AI - 日志轮转配置
# 安装: sudo cp bidmonitor-logrotate /etc/logrotate.d/bidmonitor
# 测试: sudo logrotate -d /etc/logrotate.d/bidmonitor

/opt/bidmonitor/server/logs/*.log {
    daily
    rotate 30
    compress
    delaycompress
    missingok
    notifempty
    create 0640 www-data www-data
    sharedscripts
    postrotate
        # 通知 systemd 重新打开日志文件
        systemctl reload bidmonitor 2>/dev/null || true
    endscript
}
