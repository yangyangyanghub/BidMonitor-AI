# BidMonitor AI - systemd 服务配置文件
# 安装: sudo cp bidmonitor.service /etc/systemd/system/
# 启用: sudo systemctl enable bidmonitor
# 启动: sudo systemctl start bidmonitor

[Unit]
Description=BidMonitor AI - 智能招投标监控系统
Documentation=https://github.com/BidMonitor/BidMonitor-AI
After=network.target postgresql.service mysqld.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data

# 工作目录
WorkingDirectory=/opt/bidmonitor/server

# 环境变量
Environment="PATH=/opt/bidmonitor/venv/bin:/usr/local/bin:/usr/bin"
Environment="VIRTUAL_ENV=/opt/bidmonitor/venv"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"

# 启动命令
ExecStart=/opt/bidmonitor/venv/bin/python -m uvicorn app:app \
    --host 0.0.0.0 \
    --port 8080 \
    --workers 2 \
    --log-level info \
    --access-log \
    --log-config /opt/bidmonitor/server/deploy/uvicorn-log-config.yaml

# 自动重启策略
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# 日志输出
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bidmonitor

# 资源限制
MemoryMax=2G
MemoryHigh=1536M
CPUQuota=80%
TasksMax=64
LimitNOFILE=65536

# 安全加固
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/bidmonitor/server/logs /opt/bidmonitor/data /opt/bidmonitor/server/server_config.json
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunable=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes

# 优雅关闭
TimeoutStartSec=30
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGINT
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
